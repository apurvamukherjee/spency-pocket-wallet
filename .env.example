# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave both empty to run Spency in local demo mode (no accounts, data stays in the browser).
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY names work too.
# Use the publishable key only, never the secret or service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public URL used in share links (Open Graph). Optional on Vercel, which provides the production domain.
NEXT_PUBLIC_SITE_URL=
